# ─── Supabase (required) ──────────────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ─── AI (required) ────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ─── Market Data APIs (optional — needed for ingestion) ───────
ALPACA_API_KEY=
ALPACA_API_SECRET=
FINNHUB_API_KEY=
FMP_API_KEY=
COINGECKO_API_KEY=

# ─── Prediction Markets ──────────────────────────────────────
# Kalshi is disabled — Polymarket (free, no auth) is the active source
NEWS_API_KEY=

# ─── Email (required for newsletter/briefings) ───────────────
RESEND_API_KEY=

# ─── Web Push (VAPID — browser notifications) ─────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ─── Uptime / failure alerts (leave blank to disable) ─────────
ALERT_EMAIL=

# ─── Email sender addresses (must be on a domain you own) ─────
EMAIL_FROM_WELCOME=Plebs <hello@example.com>
EMAIL_FROM_BRIEFING=Pleby from Plebs <daily@example.com>
EMAIL_FROM_BRIEF=Plebs Morning Brief <brief@example.com>
EMAIL_FROM_NEWSLETTER=Pleby from Plebs <daily@example.com>
EMAIL_FROM_ALERTS=Plebs Alerts <alerts@example.com>
EMAIL_FROM_SIGNALS=Plebs Signals <signals@example.com>

# ─── Congressional scraper contact (sent in the User-Agent) ───
EFD_CONTACT_EMAIL=you@example.com

# ─── Monitoring (optional) ────────────────────────────────────
SENTRY_DSN=
APP_ENV=development

# ─── App ──────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
ENABLE_SCHEDULER=false
PORT=8080
